<div class="container mt-5">
  <h1 class="mb-4">My tasks</h1>

  <ul class="list-unstyled">
    <% @tasks.each do |task| %>
      <li class="mb-2">
        <% if task.completed? %>
          <i class="fa-regular fa-square-check"></i>
        <% else %>
          <i class="fa-regular fa-square"></i>
        <% end %>

        <%= link_to task.title, task_path(task), class: "text-decoration-none mx-1" %>

        <%= link_to task_path(task),
                    data: { turbo_method: :delete, turbo_confirm: "Delete #{task.title}?" },
                    class: "text-secondary" do %>
          <i class="fa-regular fa-trash-can"></i>
        <% end %>
      </li>
    <% end %>
  </ul>

  <hr>
  <%= link_to new_task_path, class: "text-decoration-none" do %>
    <i class="fa-solid fa-plus"></i> Add a new task
  <% end %>
</div>
