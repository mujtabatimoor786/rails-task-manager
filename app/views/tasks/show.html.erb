<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @task.title %></h1>
    <%= link_to edit_task_path(@task), class: "btn btn-outline-secondary" do %>
      <i class="fa-solid fa-pencil"></i> Edit this task
    <% end %>
  </div>

  <div class="alert alert-secondary">
    <%= @task.details %>
  </div>

  <p>
    <% if @task.completed? %>
      <i class="fa-regular fa-square-check"></i> This task is completed
    <% else %>
      <i class="fa-regular fa-square"></i> This task is not completed yet
    <% end %>
  </p>

  <hr>
  <%= link_to tasks_path, class: "text-decoration-none" do %>
    <i class="fa-solid fa-clock-rotate-left"></i> Back to list
  <% end %>
</div>
